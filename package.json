{
  "name": "devmirror-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-config mobile browser preview with preserved HMR for local web development",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrysPy-SAM/DevMirror.git"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "devmirror": "./packages/cli/bin/devmirror.js"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter devmirror-cli run dev",
    "devmirror": "node packages/cli/bin/devmirror.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
