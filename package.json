{
  "name": "devmirror-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-config mobile browser preview with preserved HMR for local web development",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @devmirror/cli run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
