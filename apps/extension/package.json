{
  "name": "@devmirror/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome Extension for DevMirror - Browser popup dashboard and QR preview controller",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"try { require('fs').rmSync('dist', { recursive: true, force: true }); } catch {}\""
  },
  "dependencies": {
    "@devmirror/shared": "workspace:*",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.307",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^3.0.5"
  }
}
