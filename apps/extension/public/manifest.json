{
  "manifest_version": 3,
  "name": "DevMirror - Mobile Preview Dashboard",
  "version": "0.1.0",
  "description": "Browser companion dashboard for DevMirror - Preview local websites on mobile with live HMR",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "DevMirror Mobile Preview Dashboard"
  }
}
