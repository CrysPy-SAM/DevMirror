{
  "name": "@devmirror/scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Port scanning, process inspection, and framework fingerprinting for local dev servers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrysPy-SAM/DevMirror.git",
    "directory": "packages/scanner"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"try { fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true }); } catch {}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@devmirror/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
