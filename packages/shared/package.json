{
  "name": "@devmirror/shared",
  "version": "0.1.0",
  "description": "Shared types, schemas, and protocol constants for DevMirror",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrysPy-SAM/DevMirror.git",
    "directory": "packages/shared"
  },
  "keywords": [
    "devmirror",
    "types",
    "constants",
    "protocols"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"try { fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true }); } catch {}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
