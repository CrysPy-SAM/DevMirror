{
  "name": "@devmirror/core",
  "version": "0.1.0",
  "private": true,
  "description": "Core reverse proxy, session management, and local control engine for DevMirror",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"try { fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true }); } catch {}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@devmirror/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.2.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.6",
    "vitest": "^3.0.5"
  }
}
